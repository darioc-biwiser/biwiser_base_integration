# ============================================================
# PLANTILLA DE CONFIGURACIÓN POR CLIENTE
# ============================================================
#
# Copiar como .env.<cliente> (ej. .env.singolare) y ajustar.
# Se ejecuta con:  ./run_main.sh <cliente>[_f|_c|_o|_ot] [desde hasta] [ENDPOINT]
#
# Solo son obligatorias las variables marcadas [OBLIGATORIA]; el
# resto tiene un valor por defecto (el indicado en el ejemplo).
#
# ============================================================


# ============================================================
# CLIENTE
# ============================================================

# [OBLIGATORIA] Nombre del cliente (columna "cliente" en procesos).
EMPRESA=cliente_ejemplo

# ACTIVA = se ejecuta; cualquier otro valor = se omite sin error.
ESTADO=ACTIVA

# Nombre del proceso en la tabla de procesos (columna "proceso").
PROCESO_NOMBRE=BASE_INTEGRATION

ZONA_HORARIA=America/Santiago

# [OBLIGATORIA] Módulos habilitados: FINANCIERO,COMERCIAL,OPERACIONAL,OTROS
# (un módulo sin endpoints termina como SIN ENDPOINTS, no es error).
MODULOS=FINANCIERO,COMERCIAL,OPERACIONAL

# [OBLIGATORIA] Conectores habilitados (ver app/connectors/registry.py):
# bsale, odoo, smartsheet, mindicador, frankfurter, jsonplaceholder, open_meteo
CONECTORES=bsale,odoo

# Ejecución automática: desde hoy - N meses hasta hoy.
MESES_AUTOMATICO=2

# Filtros opcionales de endpoints (nombres separados por coma).
# HABILITADOS vacío = todos los del módulo.
ENDPOINTS_HABILITADOS=
ENDPOINTS_DESHABILITADOS=


# ============================================================
# PARÁMETROS DE API — DEFAULTS PARA TODOS LOS CONECTORES
# ============================================================
#
# Cada parámetro se puede sobrescribir por conector anteponiendo
# su prefijo: BSALE_MAX_WORKERS, ODOO_TIMEOUT_LECTURA, etc.
# Orden: <CONECTOR>_X  >  API_X  >  default del conector  >  default global
#
# Déjalos comentados para usar el default de cada conector.
# ------------------------------------------------------------

# Peticiones HTTP simultáneas por endpoint.
# API_MAX_WORKERS=5

# Registros por página (se limita al máximo de cada API).
# API_PAGE_SIZE=100

# Límite de peticiones por minuto por conector (0 = sin límite).
# API_MAX_REQUESTS_POR_MINUTO=0

# Reintentos por request (conexión, 429 y status reintentables).
# API_MAX_RETRY=5

# Espera base entre reintentos (crece por intento: 5s, 10s, 15s...).
# API_RETRY_BACKOFF_SEGUNDOS=5

# Espera ante 429 cuando la API no informa Retry-After.
# API_RETRY_AFTER_DEFAULT_SEGUNDOS=60

# Variación aleatoria extra de la espera (0.5 = hasta +50%).
# API_RETRY_JITTER=0.5

# Timeouts HTTP en segundos.
# API_TIMEOUT_CONEXION=15
# API_TIMEOUT_LECTURA=120

# Status HTTP que se reintentan.
# API_STATUS_REINTENTABLES=429,500,502,503,504

# Validar certificado SSL.
# API_VERIFY_SSL=1

# Tope de páginas por tramo (protege contra APIs que ignoran la paginación).
# API_MAX_PAGINAS=100000

# Reintentos de un endpoint completo (borrar + descargar + cargar).
# API_ENDPOINT_MAX_RETRY=3


# ============================================================
# CONECTOR BSALE
# ============================================================

BSALE_URL=https://api.bsale.cl/v1
BSALE_TOKEN=REEMPLAZAR_TOKEN_BSALE
BSALE_MAX_WORKERS=5
BSALE_PAGE_SIZE=50
BSALE_MAX_RETRY=5
BSALE_TIMEOUT_LECTURA=120
BSALE_STATUS_REINTENTABLES=401,429,500,502,503,504
# BSALE_MAX_REQUESTS_POR_MINUTO=0


# ============================================================
# CONECTOR ODOO (External JSON-2 API)
# ============================================================

ODOO_URL=https://empresa.odoo.com/json/2/
ODOO_TOKEN=REEMPLAZAR_API_KEY_ODOO
# Solo si el servidor aloja varias bases de datos:
# ODOO_DATABASE=empresa
ODOO_MAX_WORKERS=3
ODOO_PAGE_SIZE=1000
ODOO_TIMEOUT_LECTURA=180


# ============================================================
# CONECTOR SMARTSHEET (API 2.0)
# ============================================================
#
# Hojas definidas en app/connectors/smartsheet/endpoints.py (carga
# completa por hoja, sin filtro de fecha).

# SMARTSHEET_URL=https://api.smartsheet.com/2.0
# Token de acceso (Account → Apps & Integrations → API Access).
# SMARTSHEET_TOKEN=REEMPLAZAR_TOKEN_SMARTSHEET
# Filas por página (5000 = casi siempre una sola request por hoja).
# SMARTSHEET_PAGE_SIZE=5000
# SMARTSHEET_MAX_WORKERS=3
# Smartsheet permite 300 requests/minuto por token.
# SMARTSHEET_MAX_REQUESTS_POR_MINUTO=250
# SMARTSHEET_TIMEOUT_LECTURA=180


# ============================================================
# CONECTORES DE APIS LIBRES (sin token)
# ============================================================

# MINDICADOR_URL=https://mindicador.cl/api
# MINDICADOR_MAX_REQUESTS_POR_MINUTO=30

# FRANKFURTER_URL=https://api.frankfurter.dev/v1

# JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com
# JSONPLACEHOLDER_PAGE_SIZE=20

# OPEN_METEO_URL=https://archive-api.open-meteo.com/v1
# OPEN_METEO_LATITUD=-33.4489
# OPEN_METEO_LONGITUD=-70.6693
# OPEN_METEO_RETRASO_DIAS=5


# ============================================================
# STAGE
# ============================================================

STAGE_HOST=127.0.0.1
STAGE_PORT=5432
STAGE_USER=postgres
STAGE_PASSWORD=REEMPLAZAR
STAGE_DB=cliente_ejemplo
STAGE_SCHEMA=public

# Registros acumulados antes de insertar (1 transacción por lote).
STAGE_BATCH_SIZE=5000
# Filas por sentencia INSERT (se ajusta solo al límite de 65.535
# parámetros de Postgres según la cantidad de columnas).
STAGE_INSERT_CHUNKSIZE=800
STAGE_INSERT_MAX_RETRY=3
STAGE_INSERT_RETRY_ESPERA_SEGUNDOS=5


# ============================================================
# PROCESOS (tabla de control de ejecuciones)
# ============================================================

# 0 = no registrar en base de datos (solo log). Útil en pruebas locales.
PROCESOS_HABILITADO=1

PS_PROCESOS_HOST=127.0.0.1
PS_PROCESOS_PORT=5432
PS_PROCESOS_USER=postgres
PS_PROCESOS_PASSWORD=REEMPLAZAR
PS_PROCESOS_DB=procesos
PS_PROCESOS_SCHEMA=public
PS_PROCESOS_TABLA=procesos_dev


# ============================================================
# DWH
# ============================================================

# 0 = no traspasar a DWH (solo API → STAGE).
DWH_HABILITADO=1

DWH_HOST=127.0.0.1
DWH_PORT=5432
DWH_USER=postgres
DWH_PASSWORD=REEMPLAZAR
DWH_DB=cliente_ejemplo
DWH_SCHEMA=public
# Usuario al que se le da GRANT SELECT sobre cada tabla (vacío = no).
DWH_GRANT_USER=biwiser

# 1 = traspasar a DWH aunque el endpoint tenga requests fallidos
#     (el rango del DWH quedaría incompleto).
# 0 = no tocar el DWH de ese endpoint hasta una corrida completa.
DWH_CARGAR_CON_FALLIDOS=0

# Filas leídas de STAGE por bloque y filas por INSERT en DWH.
DWH_READ_CHUNKSIZE=20000
DWH_INSERT_CHUNKSIZE=5000


# ============================================================
# CONEXIONES A BASE DE DATOS
# ============================================================

DB_POOL_RECYCLE_SEGUNDOS=280
DB_CONNECT_TIMEOUT=15
# 0 = sin límite de tiempo por sentencia.
DB_STATEMENT_TIMEOUT_MS=0


# ============================================================
# LOGS
# ============================================================

# Nivel en consola: DEBUG, INFO, WARNING, ERROR.
LOG_NIVEL_CONSOLA=INFO
# Líneas de detalle reciente que se guardan en error/ ante una falla.
LOG_BUFFER_CAPACIDAD=2000
# 1 = guardar log completo de cada ejecución en logs/.
LOG_ARCHIVO_EJECUCION=1
# Días que se conservan los .log de error/ y logs/ (0 = nunca borrar).
LOG_RETENCION_DIAS=30

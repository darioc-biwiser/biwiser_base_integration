# ============================================================
# CLIENTE DEMO — solo APIs libres (no requiere tokens)
# ============================================================
#
#   ./run_main.sh demo                      todos los módulos
#   ./run_main.sh demo_f                    FINANCIERO (UF, dólar, tipos de cambio)
#   ./run_main.sh demo_c                    COMERCIAL (usuarios)
#   ./run_main.sh demo_o                    OPERACIONAL (posts, comentarios, clima)
#   ./run_main.sh demo_f 2026-01-01 2026-03-31
#   ./run_main.sh demo_o JSONPLACEHOLDER_COMMENTS
#
# Requiere un Postgres para STAGE/DWH/procesos (ver README,
# "Probar en local con Docker").
# ============================================================


# ============================================================
# CLIENTE
# ============================================================

EMPRESA=demo
ESTADO=ACTIVA
PROCESO_NOMBRE=BASE_INTEGRATION
ZONA_HORARIA=America/Santiago
MODULOS=FINANCIERO,COMERCIAL,OPERACIONAL
CONECTORES=mindicador,frankfurter,jsonplaceholder,open_meteo
MESES_AUTOMATICO=2
ENDPOINTS_HABILITADOS=
ENDPOINTS_DESHABILITADOS=


# ============================================================
# PARÁMETROS DE API (defaults para todos los conectores)
# ============================================================

API_MAX_RETRY=5
API_RETRY_BACKOFF_SEGUNDOS=3
API_TIMEOUT_CONEXION=15
API_TIMEOUT_LECTURA=60
API_ENDPOINT_MAX_RETRY=2


# ============================================================
# PARÁMETROS POR CONECTOR (sobrescriben los API_*)
# ============================================================

MINDICADOR_MAX_WORKERS=2
MINDICADOR_MAX_REQUESTS_POR_MINUTO=30

FRANKFURTER_MAX_WORKERS=3

JSONPLACEHOLDER_MAX_WORKERS=4
JSONPLACEHOLDER_PAGE_SIZE=20

OPEN_METEO_MAX_WORKERS=2
OPEN_METEO_MAX_REQUESTS_POR_MINUTO=60
OPEN_METEO_LATITUD=-33.4489
OPEN_METEO_LONGITUD=-70.6693


# ============================================================
# STAGE
# ============================================================

STAGE_HOST=127.0.0.1
STAGE_PORT=5432
STAGE_USER=postgres
STAGE_PASSWORD=postgres
STAGE_DB=demo_stage
STAGE_SCHEMA=public
STAGE_BATCH_SIZE=5000
STAGE_INSERT_CHUNKSIZE=800


# ============================================================
# PROCESOS
# ============================================================

PROCESOS_HABILITADO=1
PS_PROCESOS_HOST=127.0.0.1
PS_PROCESOS_PORT=5432
PS_PROCESOS_USER=postgres
PS_PROCESOS_PASSWORD=postgres
PS_PROCESOS_DB=procesos
PS_PROCESOS_SCHEMA=public
PS_PROCESOS_TABLA=procesos_dev


# ============================================================
# DWH
# ============================================================

DWH_HABILITADO=1
DWH_HOST=127.0.0.1
DWH_PORT=5432
DWH_USER=postgres
DWH_PASSWORD=postgres
DWH_DB=demo_dwh
DWH_SCHEMA=public
DWH_GRANT_USER=
DWH_CARGAR_CON_FALLIDOS=0


# ============================================================
# LOGS
# ============================================================

LOG_NIVEL_CONSOLA=INFO
LOG_ARCHIVO_EJECUCION=1
LOG_RETENCION_DIAS=30
